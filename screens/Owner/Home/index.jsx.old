import React, { useEffect, useState } from "react";
import { RefreshControl, ScrollView, StyleSheet, TouchableOpacity, View } from "react-native";
import { COLORS, Text } from "ripal-ui";
import useUser from "../../../hooks/useUser";
import axios from "axios";
import config from "../../../config";
import Grid from "@haloriyan/grid";
import { Ionicons } from "@expo/vector-icons";

const OwnerHome = ({ navigation, route }) => {
    const [user] = useUser();
    const [isLoading, setLoading] = useState(false);

    const load = async () => {
        if (isLoading) return;
        setLoading(true);

        try {
            const response = await axios.get(`${config.base_url}/api/user/home`, {
                headers: { Authorization: `Bearer ${user?.token}` }
            });
            let res = response.data;

            console.log(res);
            
        } catch (err) {
            console.error(err);
            console.error(err?.response?.data);
        } finally {
            setLoading(false);
        }
    }

    useEffect(() => {
        if (user !== null) {
            load();
        }
    }, [user]);

    if (user === null) return;
    
    return (
        <React.Fragment>
            <View style={styles.header}>
                <Text size={11} color="#fff">Halo,</Text>
                <Text style={{ fontWeight: '600' }} color="#fff">{user.name}</Text>
            </View>
            <ScrollView contentContainerStyle={styles.container} refreshControl={
                <RefreshControl refreshing={isLoading} onRefresh={() => {
                    load();
                }} />
            }>
                <View style={[styles.pad]}>
                    <Grid col={4} gap={20}>
                        <TouchableOpacity style={styles.tile}>
                            <View style={{
                                ...styles.icon,
                                backgroundColor: `${COLORS.primary}20`
                            }}>
                                <Ionicons name="add-outline" size={32} color={COLORS.primary} />
                            </View>
                            <Text size={11} align={'center'} style={{ fontWeight: '600' }}>Buat Pesanan</Text>
                        </TouchableOpacity>
                        <TouchableOpacity style={styles.tile}>
                            <View style={{
                                ...styles.icon,
                                backgroundColor: `${COLORS.orange[500]}20`
                            }}>
                                <Ionicons name="cube-outline" size={32} color={COLORS.orange[500]} />
                            </View>
                            <Text size={11} align={'center'} style={{ fontWeight: '600' }}>Tambah Produk</Text>
                        </TouchableOpacity>
                        <TouchableOpacity style={styles.tile}>
                            <View style={{
                                ...styles.icon,
                                backgroundColor: `${COLORS.primary}20`
                            }}>
                                <Ionicons name="cube-outline" size={32} color={COLORS.primary} />
                            </View>
                            <Text size={11} align={'center'} style={{ fontWeight: '600' }}>Tambah Produk</Text>
                        </TouchableOpacity>
                        <TouchableOpacity style={styles.tile}>
                            <View style={{
                                ...styles.icon,
                                backgroundColor: `${COLORS.primary}20`
                            }}>
                                <Ionicons name="cube-outline" size={32} color={COLORS.primary} />
                            </View>
                            <Text size={11} align={'center'} style={{ fontWeight: '600' }}>Tambah Produk</Text>
                        </TouchableOpacity>
                    </Grid>
                </View>
            </ScrollView>
        </React.Fragment>
    )
}

const styles = StyleSheet.create({
    header: {
        backgroundColor: COLORS.primary,
        padding: 20,
        paddingTop: 60,
        gap: 4,
    },
    container: {
        backgroundColor: "#fff",
        flexGrow: 1,
        gap: 20,
    },
    pad: { padding: 20 },
    icon: {
        width: '80%',
        aspectRatio: 1,
        borderRadius: 999,
        alignItems: 'center',
        justifyContent: 'center'
    },
    tile: {
        alignItems: 'center',
        gap: 10,
    }
});

export default OwnerHome;