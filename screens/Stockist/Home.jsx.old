import React, { useEffect, useRef, useState } from "react";
import { Image, RefreshControl, ScrollView, StyleSheet, TextInput, View } from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import { Button, COLORS, Dialog, Inline, Text } from "ripal-ui";
import useUser from "../../hooks/useUser";
import Initial from "../../lib/Initial";
import axios from "axios";
import config from "../../config";
import dayjs from "dayjs";
import DateTimePicker, { useDefaultStyles } from "react-native-ui-datepicker";
import { Ionicons } from "@expo/vector-icons";
import { useDebouncedCallback } from "use-debounce";

const StockistHome = ({ navigation, route }) => {
    const [scroll, setScroll] = useState(0);
    const scrollRef = useRef(0);
    const [top, setTop] = useState(-100);
    const [user] = useUser();
    const [isLoading, setLoading] = useState(false);

    const [q, setQ] = useState('');
    const [raw, setRaw] = useState(null);
    const [page, setPage] = useState(1);
    const [products, setProducts] = useState([]);
    const [startDate, setStartDate] = useState(dayjs().subtract(7, 'days'));
    const [endDate, setEndDate] = useState(dayjs());
    const [tempStartDate, setTempStartDate] = useState(dayjs().subtract(7, 'days'));
    const [tempEndDate, setTempEndDate] = useState(dayjs());
    const pickerDefaultStyles = useDefaultStyles();
    const [showCalendar, setShowCalendar] = useState(false);

    useEffect(() => {
        if (scroll > scrollRef.current) {
            // ke bawah
            if (top < 0 && scroll > 70) {
                setTop(prev => prev + 10);
            }
        } else {
            // ke atas 
            if (top > -150) {
                setTop(prev => prev - 10);
            }
        }
        scrollRef.current = scroll;
    }, [scroll, scrollRef]);

    const load = async () => {
        if (isLoading) return;

        setLoading(true);
        try {
            
            const response = await axios.get(`${config.base_url}/api/stockist/home?q=${q}&page=${page}&start_date=${startDate.format('YYYY-MM-DD')}&end_date=${endDate.format('YYYY-MM-DD')}`, {
                headers: { Authorization: `Bearer ${user.token}` }
            });
            let res = response.data;

            // setProducts(res.products);
            setRaw(res.products);
            setProducts(prev => [...prev, ...res.products.data]);
        } catch (err) {
            console.error(err);
            console.error(err?.response?.data);
        } finally {
            setLoading(false);
        }
    }

    useEffect(() => {
        if (user !== null) {
            load();
        }
    }, [user, page]);

    const debounceSearch = useDebouncedCallback(() => {
        load();
    }, 1000);

    if (user === null) return; 

    return (
        <React.Fragment>
            <ScrollView contentContainerStyle={styles.container} scrollEventThrottle={16} onScroll={e => {
                let pos = e.nativeEvent.contentOffset.y;
                setScroll(pos);
            }} refreshControl={
                <RefreshControl refreshing={isLoading} onRefresh={() => {
                    setProducts([]);
                    setPage(1);
                    if (page === 1) {
                        load();
                    }
                }} />
            }>
                <Inline gap={10}>
                    <Button circle>
                        <Text color="#fff" style={{ fontWeight: '800' }}>{Initial(user.name)}</Text>
                    </Button>
                    <View style={{ flexGrow: 1, flexBasis: 10, flexShrink: 1, gap: 5 }}>
                        <Text size={18} color={COLORS.slate[800]} style={{ fontWeight: '700' }}>{user?.name}</Text>
                        <Text size={11}>{user?.access.store.name}</Text>
                    </View>
                    <Button circle accent="secondary" color={COLORS.red[500]} style={{ borderRadius: 8 }} onPress={() => {
                        // navigation.navigate('AuthNavigator', {
                        //     screen: "Logout"
                        // });

                        navigation.navigate('StockistStoreSelector');
                    }}>
                        <Ionicons name="log-out-outline" color={COLORS.red[500]} size={18} />
                    </Button>
                </Inline>

                <Inline>
                    <View style={{ flexGrow: 1, flexBasis: 10, flexShrink: 1, gap: 5 }}>
                        <Inline gap={5}>
                            <Ionicons name="calendar-outline" />
                            <Text size={11}>Rentang Tanggal</Text>
                        </Inline>
                        <Text size={12} color={COLORS.slate[800]} style={{ fontWeight: '700' }}>
                            {startDate.format('DD MMMM')} - {endDate.format('DD MMMM YYYY')}
                        </Text>
                    </View>

                    <Button accent="tertiary" onPress={() => setShowCalendar(true)}>Ubah</Button>
                </Inline>

                <Inline style={styles.search} gap={0}>
                    <Button circle accent="tertiary">
                        <Ionicons name="search-outline" size={18} color={COLORS.slate[500]} />
                    </Button>
                    <TextInput style={styles.search_input} value={q} onChangeText={e => {
                        setQ(e);
                        debounceSearch();
                    }} placeholder="Cari produk" />
                    { q !== "" &&
                        <Button circle accent="tertiary" onPress={() => {
                            setQ('');
                            debounceSearch();
                        }}>
                            <Ionicons name="close-outline" size={18} color={COLORS.slate[500]} />
                        </Button>
                    }
                </Inline>

                <View style={{ gap: 15 }}>
                    { products.map((prod, p) => (
                        <Inline key={p} style={[styles.item, styles.shadow]} gap={10} onPress={() => {
                            navigation.navigate('StockistDetail', {
                                product: prod,
                            })
                        }}>
                            <Image style={styles.product_image} source={{ uri: `${config.base_url}/storage/product_images/${prod.id}/${prod.images[0].filename}` }} />
                            <View style={{ flexGrow: 1,flexShrink: 1,flexBasis: 10,gap: 10 }}>
                                <Text color={COLORS.slate[800]} style={{ fontWeight: '700' }}>{prod.name}</Text>
                                <Inline gap={15}>
                                    <View style={{ gap: 4}}>
                                        <Inline gap={5}>
                                            <Ionicons name="download-outline" />
                                            <Text size={11}>Masuk</Text>
                                        </Inline>

                                        <Text style={{ fontWeight: '600' }}>{prod.inbound}</Text>
                                    </View>
                                    <View style={{ gap: 4}}>
                                        <Inline gap={5}>
                                            <Ionicons name="download-outline" style={{ transform: [{ rotate: '180deg' }] }} />
                                            <Text size={11}>Keluar</Text>
                                        </Inline>

                                        <Text style={{ fontWeight: '600' }}>{prod.outbound}</Text>
                                    </View>
                                    {/* <View style={{ gap: 4}}>
                                        <Inline gap={5}>
                                            <Ionicons name="sync-outline" />
                                            <Text size={11}>Opname</Text>
                                        </Inline>

                                        <Text style={{ fontWeight: '600' }}>{prod.opname}</Text>
                                    </View> */}
                                </Inline>
                            </View>
                            <View style={{ gap: 5 }}>
                                <Text size={10}>Tersedia</Text>
                                <Text size={20} color={COLORS.primary} style={{ fontWeight: '800' }}>{prod.quantity}</Text>
                            </View>
                        </Inline>
                    ))}
                </View>

                { raw?.next_page_url !== null &&
                    <Button accent="secondary" style={{ width: '100%' }} onPress={() => {
                        setPage(prev => prev + 1);
                    }}>Lainnya</Button>
                }
                <View style={{ height: 80 }} />
            </ScrollView>

            <Inline style={{
                ...styles.header,
                top,
            }}>
                <Text>Header</Text>
            </Inline>

            <Inline style={styles.bottom}>
                {/* <Button color="#fff" style={{ borderWidth: 1,borderColor: "#ddd", gap: 10 }} onPress={() => {
                    navigation.navigate('StockistOpname');
                }}>
                    <Ionicons name="sync-outline" size={20} />
                    <Text size={12} style={{ fontWeight: '600' }}>Opname</Text>
                </Button> */}
                <View style={{ flexGrow: 1 }} />
                <Button style={{ gap: 10 }} onPress={() => navigation.navigate('StockistAdd')}>
                    <Ionicons name="add-outline" color={'#fff'} size={20} />
                    <Text size={12} color="#fff" style={{ fontWeight: '600' }}>Tambah Stok</Text>
                </Button>
            </Inline>

            { showCalendar && 
                <Dialog visible={showCalendar} onClose={() => setShowCalendar(false)}>
                    <Dialog.Title>Rentang Tanggal</Dialog.Title>
                    <Dialog.Body>
                        <DateTimePicker
                            styles={{
                                ...pickerDefaultStyles,
                                selected: {
                                    backgroundColor: COLORS.primary,
                                }
                            }}
                            mode="range"
                            startDate={tempStartDate}
                            endDate={tempEndDate}
                            onChange={({startDate, endDate}) => {
                                setTempStartDate(dayjs(startDate));
                                setTempEndDate(dayjs(endDate));
                            }}
                        />
                    </Dialog.Body>
                    <Dialog.Actions>
                        <Button onPress={() => {
                            setStartDate(tempStartDate);
                            setEndDate(tempEndDate);
                            setShowCalendar(false);
                        }}>Selesai</Button>
                    </Dialog.Actions>
                </Dialog>
            }
        </React.Fragment>
    )
}

const styles = StyleSheet.create({
    container: {
        padding: 20,
        paddingTop: 80,
        flexGrow: 1,
        backgroundColor: "#fff",
        gap: 20,
    },
    header: {
        backgroundColor: "#fff",
        position: 'absolute',
        left: 0,right: 0,
        padding: 20,
        paddingTop: 65,
        shadowColor: "#ddd",
        shadowOffset: { width: 1,height: 1 },
        shadowOpacity: 0.7,
        shadowRadius: 10,
        elevation: 3,
    },
    shadow: {
        shadowColor: "#ddd",
        shadowOffset: { width: 1, height: 1 },
        shadowOpacity: 0.7,
        shadowRadius: 10,
        elevation: 3,
    },
    item: {
        backgroundColor: "#fff",
        padding: 20,
        borderRadius: 12,
    },
    product_image: {
        width: 64,
        height: 64,
        backgroundColor: "#eee",
        borderRadius: 12,
    },
    search: {
        backgroundColor: COLORS.slate[100],
        borderRadius: 99,
        paddingHorizontal: 10,
    },
    search_input: {
        height: 48,
        flexGrow: 1,
    },
    bottom: {
        position: 'absolute',
        bottom: 0,left: 0,right: 0,
        padding: 20,
        paddingBottom: 40,
    }
});

export default StockistHome;