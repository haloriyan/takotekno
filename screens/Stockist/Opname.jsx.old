import axios from "axios";
import React, { useEffect, useState } from "react";
import { ActivityIndicator, Alert, Image, StyleSheet, TextInput, TouchableOpacity, View } from "react-native";
import { KeyboardAwareScrollView as ScrollView } from "react-native-keyboard-aware-scroll-view";
import { Button, COLORS, Inline, Text } from "ripal-ui";
import config from "../../config";
import useUser from "../../hooks/useUser";
import { Ionicons } from "@expo/vector-icons";
import { useDebouncedCallback } from "use-debounce";
import Currency from "../../lib/Currency";
import dayjs from "dayjs";

const StockistOpname = ({ route, navigation }) => {
    const [user] = useUser();
    const [items, setItems] = useState([]);
    const [itemIDs, setItemIDs] = useState([]);

    const [isSearching, setSearching] = useState(false);
    const [q, setQ] = useState('');
    const [results, setResults] = useState([]);
    const [isAdding, setAdding] = useState(false);

    const search = async () => {
        if (isSearching) return;

        setSearching(true);
        try {
            const response = await axios.post(`${config.base_url}/api/stockist/search`, {
                q,
            }, { headers: { Authorization: `Bearer ${user?.token}` }});
            let res = response.data;

            setResults(res.products);

        } catch (err) {
            console.error(err);
            console.error(err?.response?.data);
        } finally {
            setSearching(false);
        }
    }

    useEffect(() => {
        if (user !== null) {
            search();
        }
    }, [user]);

    const debounceSearch = useDebouncedCallback(() => {
        search();
    }, 1000);

    const controlQty = (productIndex, stockIndex, action) => {
        let theItems = [...items];
        let theStock = theItems[productIndex].stocks[stockIndex];
        console.log(theStock);
        

        if (action === "increase") {
            // 
        }
    }
    const controlQtyx = (index, action) => {
        let theItems = [...items];
        let theItemIDs = [...itemIDs];

        if (action === "increase") {
            theItems[index]['quantity'] += 1;
        } else {
            if (theItems[index]['quantity'] === 1) {
                theItemIDs.map((id, i) => {
                    if (id === theItems[index]?.product.id) {
                        theItemIDs.splice(i, 1);
                    }
                });
                theItems.splice(index, 1);
            } else {
                theItems[index]['quantity'] -= 1;
            }
        }

        setItems(theItems);
        setItemIDs(theItemIDs);
    }

    const submit = async () => {
        if (isAdding) return;

        setAdding(true);

        try {
            const response = await axios.post(`${config.base_url}/api/stockist/store`, {
                items,
            }, { headers: { Authorization: `Bearer ${user.token}` }});
            let res = response.data;

            Alert.alert(
                'Berhasil!', res.message,
                [
                    { text: "Kembali", onPress: () => {
                        navigation.goBack()
                    }}
                ]
            )
        } catch (err) {
            console.error(err);
            console.error(err?.response?.data);
        } finally {
            setAdding(false);
        }
    }

    return (
        <React.Fragment>
            <ScrollView contentContainerStyle={styles.container} nestedScrollEnabled={true}>
                <View>
                    <Inline style={{...styles.search_box, margin: 20}}>
                        <View style={{ flexBasis: 10,flexGrow: 1 }}>
                            <Text size={11}>Cari Produk</Text>
                            <TextInput style={styles.search_input} value={q} onChangeText={e => {
                                setQ(e);
                                debounceSearch();
                            }} />
                        </View>
                        <Button accent="tertiary">
                            <Ionicons name="search-outline" size={20} color={COLORS.slate[800]} />
                        </Button>
                    </Inline>
                    <ScrollView contentContainerStyle={{ gap: 10,backgroundColor: "#fff" }} horizontal showsHorizontalScrollIndicator={false}>
                        <View /><View />
                        { results.map((prod, r) => {
                            let index = itemIDs.indexOf(prod.id);
                            if (index < 0) {
                                return (
                                    <Inline key={r} style={[styles.product]} gap={10} onPress={() => {
                                        setItems(prev => [...prev, {
                                            product: prod,
                                            // quantity: prod.available_stocks[0].quantity,
                                            stocks: prod.available_stocks,
                                        }]);
                                        setItemIDs(prev => [...prev, prod.id]);
                                    }}>
                                        <Image style={styles.product_image} source={{ uri: `${config.base_url}/storage/${prod.store_id}/product_images/${prod.id}/${prod.images[0].filename}` }} />
                                        <Text size={12} style={{ fontWeight: '600' }}>{prod.name}</Text>
                                    </Inline>
                                )
                            }
                        })}
                        <View /><View />
                    </ScrollView>
                </View>

                <View style={{ padding: 20, gap: 25 }}>
                    { items.map((item, i) => (
                        <View key={i} style={{ gap: 10 }}>
                            <Inline gap={15}>
                                <Image 
                                    style={{...styles.product_image, width: 48, height: 48,borderRadius: 99 }} 
                                    source={{ uri: `${config.base_url}/storage/${item.product.store_id}/product_images/${item.product.id}/${item.product.images[0].filename}` }}
                                />
                                <View style={{ flexGrow: 1,flexBasis: 10,flexShrink: 1, gap: 6 }}>
                                    <Text size={14} style={{ fontWeight: '600' }}>{item.product.name}</Text>
                                </View>
                            </Inline>
                            <View />

                            { item.stocks.map((sto, s) => (
                                <View style={[styles.stock_item, styles.shadow]}>
                                    <Inline>
                                        <View style={{ flexBasis: 10,flexGrow: 1,flexShrink: 1,gap: 8 }}>
                                            <Text color={COLORS.slate[800]} style={{ fontWeight: '700' }}>{sto.label}</Text>
                                            <Text color={COLORS.slate[500]} size={11}>Ditambahkan pada {dayjs(sto.created_at).format('DD MMM YYYY, HH:mm')}</Text>
                                        </View>
                                        <Inline gap={0}>
                                            <TouchableOpacity style={styles.qty_btn} onPress={() => {
                                                controlQty(i, s, 'decrease');
                                            }}>
                                                <Ionicons name="remove" />
                                            </TouchableOpacity>
                                            <TextInput keyboardType="numeric" style={styles.qty_input} value={sto.quantity.toString()} onChangeText={e => {
                                                // let theItems = [...items];
                                                // theItems[i]['quantity'] = e;
                                                // setItems(theItems);
                                            }} />
                                            <TouchableOpacity style={styles.qty_btn} onPress={() => {
                                                controlQty(i, s, 'increase');
                                            }}>
                                                <Ionicons name="add" />
                                            </TouchableOpacity>
                                        </Inline>
                                    </Inline>
                                </View>
                            ))}
                        </View>
                    ))}
                </View>
            </ScrollView>

            <View style={styles.bottom}>
                <Button style={{ width: '100%' }} onPress={submit}>
                    { isAdding ? <ActivityIndicator size={12} color={'#fff'} /> : 'Tambahkan' }
                </Button>
            </View>
        </React.Fragment>
    )
}

const styles = StyleSheet.create({
    container: {
        backgroundColor: "#fff",
        gap: 20,
        flexGrow: 1,
    },
    shadow: {
        shadowColor: "#ddd",
        shadowOffset: { width: 1, height: 1 },
        shadowOpacity: 0.7,
        shadowRadius: 10,
        elevation: 3,
    },
    search_box: {
        borderWidth: 1,
        borderColor: "#ddd",
        borderRadius: 12,
        padding: 10,
    },
    search_input: {
        width: '100%',
        height: 32,
    },
    product: {
        backgroundColor: "#fff",
        borderRadius: 999,
        padding: 5,
        paddingRight: 15,
        zIndex: 1,
        elevation: 1,
        borderWidth: 1,
        borderColor: "#ddd"
    },
    product_image: {
        backgroundColor: "#eee",
        width: 32,
        height: 32,
        borderRadius: 999,
    },
    qty_btn: {
        width: 28,
        aspectRatio: 1,
        borderRadius: 99,
        borderWidth: 1,
        borderColor: "#ddd",
        alignItems: 'center',
        justifyContent: 'center'
    },
    qty_input: {
        height: 28,
        width: 36,
        textAlign: 'center'
    },
    bottom: {
        padding: 20,
        backgroundColor: "#fff"
    },
    stock_item: {
        padding: 20,
        borderRadius: 8,
        backgroundColor: "#fff",
    }
});

export default StockistOpname;